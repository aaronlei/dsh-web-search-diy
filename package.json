{
  "name": "dsh-web-search-diy",
  "version": "2.0.4",
  "description": "DSH web search provider selected by vendor x protocol: Chat Completions, Responses, and Anthropic Messages with built-in search tools, plus the standalone search APIs of DeepSeek, Kimi, and Zhipu; four custom targets cover gateways; UI copy follows the app language (zh, en, ja, es, fr, de, ru, pt).",
  "icon": "./icon.svg",
  "license": "MIT",
  "author": "aaronlei",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsdown",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "node --test \"test/**/*.test.mjs\"",
    "test:client": "tsdown && node scripts/verify-client.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2 || ^0.2.1-rc.2 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "^0.1.6-alpha.2 || ^0.2.0-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "^0.1.6-alpha.2 || ^0.2.0-rc.1 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2 || ^0.2.1-rc.2 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-web": "^0.1.6-alpha.2 || ^0.2.0-rc.1 || ^0.2.2-alpha.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.6-alpha.1",
    "@deepseek-ai/dsh-agent": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-credentials": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-session": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-web": "0.2.2-alpha.2",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "lib",
    "!lib/**/*.map",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "deepseek",
    "dsh",
    "plugin",
    "web-search",
    "web_search",
    "diy-search",
    "dashscope",
    "openai-compatible",
    "responses-api",
    "qwen",
    "zhipu",
    "bigmodel",
    "glm",
    "anthropic-messages",
    "messages-api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aaronlei/dsh-web-search-diy.git"
  }
}
